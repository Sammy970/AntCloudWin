<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:AntCloud.Controls"
             x:Class="AntCloud.Views.NetworkPane">
  <!-- How a stream would feel, measured without starting the cloud PC. -->
  <ScrollViewer>
    <StackPanel Margin="40,8,40,40" MaxWidth="640" HorizontalAlignment="Left" Spacing="16">
      <StackPanel Spacing="4" c:Reveal.Delay="0">
        <TextBlock Classes="title" Text="How would a stream feel right now?" />
        <TextBlock Classes="secondary wrap"
                   Text="Measures your connection to AntCloud's servers, which share a network with the cloud PCs, so you get an idea without starting one." />
      </StackPanel>

      <!-- Latency -->
      <Border Classes="card" Padding="20" c:Reveal.Delay="0.06">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="subtitle" Text="Latency" VerticalAlignment="Bottom" />
            <TextBlock x:Name="Median" Grid.Column="1" Classes="num" FontSize="20" FontWeight="SemiBold" />
          </Grid>
          <c:SampleBars x:Name="Bars" Height="54" Empty="{DynamicResource TrackOff}" />
          <c:LatencyScale x:Name="Scale" LabelBrush="{DynamicResource TextSecondary}" />
        </StackPanel>
      </Border>

      <!-- Stats -->
      <Border Classes="card" Padding="0,16" c:Reveal.Delay="0.12">
        <Grid ColumnDefinitions="*,1,*,1,*">
          <StackPanel Spacing="2" HorizontalAlignment="Center" ToolTip.Tip="How much latency varies. Under 10 ms is steady.">
            <TextBlock x:Name="Jitter" Classes="num" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="–" />
            <TextBlock Classes="caption secondary" Text="Jitter" HorizontalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" Height="36" />
          <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center" ToolTip.Tip="Attempts that got no answer.">
            <TextBlock x:Name="Loss" Classes="num" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="–" />
            <TextBlock Classes="caption secondary" Text="Packet loss" HorizontalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" Height="36" />
          <StackPanel Grid.Column="4" Spacing="2" HorizontalAlignment="Center" ToolTip.Tip="Your internet speed, measured through Cloudflare.">
            <TextBlock x:Name="Download" Classes="num" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="–" />
            <TextBlock Classes="caption secondary" Text="Download" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Verdict -->
      <Border x:Name="Verdict" Classes="card" Padding="20" IsVisible="False">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:StrokeIcon x:Name="VerdictIcon" Width="18" Height="18" />
            <TextBlock x:Name="VerdictTitle" Classes="subtitle" />
          </StackPanel>
          <TextBlock x:Name="Advice" Classes="secondary wrap" />
          <StackPanel x:Name="Suggestion" Spacing="12">
            <Border Classes="divider" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="SuggestedText" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentText" Classes="caption secondary" />
              </StackPanel>
              <Button x:Name="UseSuggested" Grid.Column="1" Classes="secondary" Click="ApplySuggested" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="Failure" CornerRadius="6" BorderThickness="1" Padding="14,12" IsVisible="False"
              Background="#14F7A325" BorderBrush="#40F7A325">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <c:StrokeIcon Data="{x:Static c:Icons.Warning}" Foreground="{StaticResource WarnBrush}" />
          <TextBlock x:Name="FailureText" Classes="wrap" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="14" c:Reveal.Delay="0.18">
        <Button x:Name="Run" Classes="accent primary" Width="200" Click="RunClicked">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:StrokeIcon Data="{x:Static c:Icons.Gauge}" Width="15" Height="15" StrokeWidth="2.4" />
            <TextBlock x:Name="RunText" Text="Run Test" Foreground="{Binding $parent[Button].Foreground}" x:CompileBindings="False" />
          </StackPanel>
        </Button>
        <StackPanel x:Name="Running" Orientation="Horizontal" Spacing="10" IsVisible="False" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="64" MinWidth="0" VerticalAlignment="Center" />
          <TextBlock x:Name="RunningText" Classes="secondary" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="BusyText" Classes="secondary" VerticalAlignment="Center" IsVisible="False"
                   Text="Available when you're not streaming." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
