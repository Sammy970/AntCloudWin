<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:AntCloud.Controls"
        xmlns:v="using:AntCloud.Views">

  <!-- Type: Segoe UI Variable through a small ramp, as in Windows 11 Settings. -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="46" />
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,18,0,6" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="TextBlock.wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- Cards: the Windows 11 layer — a faint fill, a hairline and 8px corners. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <!-- Setting rows, stacked with 4px gaps like the Settings app. -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- Primary action: the Fluent accent button, a little taller. -->
  <Style Selector="Button.primary">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
  </Style>

  <!-- Quiet icon button (account menu, dismiss). -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
  </Style>

  <!-- Sign-in: the brand-gradient glow pill. It stays clearly blue when disabled, just dimmer. -->
  <Style Selector="Button.glow">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#5C9EFF" Offset="0" />
        <GradientStop Color="#4A86E8" Offset="0.5" />
        <GradientStop Color="#5C5CE6" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Effect">
      <DropShadowEffect Color="#4A86E8" BlurRadius="20" OffsetY="5" Opacity="0.55" />
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.glow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#6AA7FF" Offset="0" />
        <GradientStop Color="#5590EE" Offset="0.5" />
        <GradientStop Color="#6868EA" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
  </Style>
  <Style Selector="Button.glow:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3F78D6" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.glow:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Effect" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.glow:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#5C9EFF" Offset="0" />
        <GradientStop Color="#4A86E8" Offset="0.5" />
        <GradientStop Color="#5C5CE6" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Login fields: large, like the Windows sign-in boxes. -->
  <Style Selector="TextBox.large">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Sidebar navigation, as in Windows 11 Settings: a soft highlight and an accent pill on the left. -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillHover}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem Border.pill">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scaleY(0.4)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Border.pill">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scaleY(1)" />
  </Style>

  <!-- Segmented control: a row of toggle buttons in one rounded track. -->
  <Style Selector="c|Segmented">
    <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="c|Segmented ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="c|Segmented ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="c|Segmented ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>

  <!-- Content reveals: fades up into place, staggered with c:Reveal.Delay. -->
  <Style Selector="ToolTip">
    <Setter Property="MaxWidth" Value="320" />
  </Style>
  <!-- Settings row template (v:SettingRow). -->
  <Style Selector="v|SettingRow">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:StrokeIcon Data="{TemplateBinding Icon}" Width="20" Height="20" StrokeWidth="1.6" Margin="2,0,18,0"
                          VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}" FontSize="14" />
              <TextBlock Text="{TemplateBinding Detail}" FontSize="12" TextWrapping="Wrap" Classes="secondary"
                         IsVisible="{Binding $parent[v:SettingRow].Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="24,0,0,0" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
