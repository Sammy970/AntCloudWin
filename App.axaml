<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AntCloud.App"
             Name="AntCloud"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Windows 11 neutrals; AntCloud blue is the only accent. Status colours carry meaning only. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" />
          <SolidColorBrush x:Key="ContentBackground" Color="#80FFFFFF" />
          <SolidColorBrush x:Key="CardBackground" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#0F000000" />
          <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
          <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
          <SolidColorBrush x:Key="TextTertiary" Color="#72000000" />
          <SolidColorBrush x:Key="SubtleFill" Color="#0A000000" />
          <SolidColorBrush x:Key="SubtleFillHover" Color="#06000000" />
          <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
          <SolidColorBrush x:Key="TrackOff" Color="#29000000" />
          <SolidColorBrush x:Key="ScrimBrush" Color="#4D000000" />
          <SolidColorBrush x:Key="DialogBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DangerText" Color="#C42B1C" />
          <SolidColorBrush x:Key="OverlayCard" Color="#F2F9F9F9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackground" Color="#202020" />
          <SolidColorBrush x:Key="ContentBackground" Color="#4D3A3A3A" />
          <SolidColorBrush x:Key="CardBackground" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
          <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF" />
          <SolidColorBrush x:Key="SubtleFill" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="SubtleFillHover" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />
          <SolidColorBrush x:Key="TrackOff" Color="#3DFFFFFF" />
          <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
          <SolidColorBrush x:Key="DialogBackground" Color="#2B2B2B" />
          <SolidColorBrush x:Key="DangerText" Color="#FF99A4" />
          <SolidColorBrush x:Key="OverlayCard" Color="#F22C2C2C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Color x:Key="AntBlueColor">#4A86E8</Color>
      <SolidColorBrush x:Key="AntBlue" Color="#4A86E8" />
      <SolidColorBrush x:Key="GoodBrush" Color="#2EB85C" />
      <SolidColorBrush x:Key="WarnBrush" Color="#F7A325" />
      <SolidColorBrush x:Key="BadBrush" Color="#E5484D" />
      <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, $Default</FontFamily>
      <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, $Default</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4A86E8" />
        <ColorPaletteResources x:Key="Dark" Accent="#4A86E8" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AntCloud/Styles.axaml" />
  </Application.Styles>
</Application>
